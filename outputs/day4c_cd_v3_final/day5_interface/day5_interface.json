{
  "name": "Day4C_CD_V3_1_Fixed Safety Interface",
  "bundle_path": "outputs\\day4c_cd_v3_final\\day5_interface\\day5_cd_v3_interface.pkl",
  "methods": [
    "predict_cd",
    "predict_cd_interval",
    "predict_ood",
    "predict_trust_region",
    "predict_reliability",
    "predict_safety",
    "predict_full"
  ],
  "prediction_columns": [
    "cd_p10",
    "cd_p50",
    "cd_p90",
    "cd_c90_lo",
    "cd_c90_hi",
    "uncertainty_width",
    "geometry_ood_score",
    "geometry_ood_flag",
    "flow_ood_score",
    "flow_ood_flag",
    "trust_region_score",
    "trust_region_class",
    "cd_physics_flag",
    "reliability_score",
    "safety_flag"
  ],
  "safety_rule": "safety_flag=False if UNSAFE trust region OR geometry/flow OOD OR Cd physics flag OR unreliable uncertainty.",
  "required_input": "Day2-compatible DataFrame with g_* geometry grid, angle, reynolds/log10_re, and geometry descriptors.",
  "strict_feature_validation": true,
  "config": {
    "input_csv": ".\\deeplearwing_day2_tabular.csv",
    "output_dir": ".\\outputs\\day4c_cd_v3_final",
    "random_state": 42,
    "test_size": 0.2,
    "calibration_size": 0.2,
    "max_rows": null,
    "max_features": 260,
    "pca_variance": 0.995,
    "pca_max_components": 32,
    "geometry_ood_percentile": 95.0,
    "flow_ood_percentile": 95.0,
    "quantiles": [
      0.1,
      0.5,
      0.9
    ],
    "bootstrap_models": 3,
    "bootstrap_fraction": 0.9,
    "n_estimators": 650,
    "learning_rate": 0.035,
    "max_leaf_nodes": 31,
    "min_samples_leaf": 20,
    "logo_max_geometries": 0,
    "logo_min_rows_per_geometry": 5,
    "logo_sample_train_rows": 0,
    "logo_refit_pca_each_fold": true,
    "logo_mode": "removed",
    "logo_cv_splits": 5,
    "geometry_cv_enabled": true,
    "geometry_cv_splits": 5,
    "geometry_cv_p50_only": true,
    "geometry_cv_bootstrap_models": 1,
    "geometry_cv_global_only": true,
    "geometry_cv_n_estimators": 180,
    "regime_models_enabled": true,
    "use_isotonic_calibration": false,
    "baseline_metrics_csv": null,
    "target_rmse_tolerance": 0.0,
    "coverage90_min": 0.88,
    "coverage90_max": 0.92,
    "disable_logo": true,
    "disable_ood": false,
    "n_jobs": 12,
    "memory_guard_enabled": true,
    "memory_safety_gb": 2.0,
    "training_mem_multiplier": 2.5,
    "outer_parallel_mem_multiplier": 4.0
  }
}